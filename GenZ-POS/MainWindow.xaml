<Window x:Class="GenZPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        Title="GenZ-POS" Icon="pack://application:,,,/Assets/app.ico"
        Height="800" Width="1280" MinWidth="1024" MinHeight="640" WindowState="Maximized">
    <!-- WPF is only the window; the whole UI is Blazor. Root component is added in code-behind. -->
    <blazor:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot\index.html" />
</Window>
