@page "/ledger"
@page "/ledger/{CustomerId:int}"
@attribute [Authorize(Policy = Permissions.CustomersManage)]
@inherits PageBase
@inject ReportService Reports
@inject DesktopService Desktop
@inject ShopInfo Shop

<RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="no-print">Customer Ledger</RadzenText>

<RadzenCard class="rz-mb-3 no-print" data-enter-group="true">
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
        <RadzenFormField Text="Customer" Style="min-width:300px; flex:1">
            <RadzenDropDown TValue="int" OpenOnFocus="true" @bind-Value="customerId" @bind-Value:after="LoadAsync" Data="@customers" TextProperty="Label" ValueProperty="Id"
                            AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="Select customer" />
        </RadzenFormField>
        <DateRangeBar @bind-From="from" @bind-To="to" Changed="LoadAsync" />
        <RadzenButton Text="Show" Icon="search" Click="LoadAsync" Disabled="@(customerId == 0)" IsBusy="@loading" class="rz-mb-2" data-enter-submit="true" />
    </RadzenStack>
    @if (customerId > 0)
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
            <RadzenButton Text="Receive payment" Icon="payments" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Size="ButtonSize.Small"
                          Click="@(() => Nav.NavigateTo($"payments?customer={customerId}"))" />
            <RadzenButton Text="Print" Icon="print" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@Desktop.PrintAsync" Disabled="@(ledger is null)" />
            <RadzenButton Text="Export CSV" Icon="download" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ExportAsync" Disabled="@(ledger is null)" />
        </RadzenStack>
    }
</RadzenCard>

@if (ledger is not null)
{
    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
            <div>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@Shop.Name — Customer Statement</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0"><strong>@shownName</strong></RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@Date(shownFrom) to @Date(shownTo)</RadzenText>
            </div>
            <RadzenStack Gap="0.25rem" Style="width:280px">
                <TotalLine Label="Opening balance" Value="@Money(ledger.Opening)" />
                <TotalLine Label="Debit (invoices, refunds)" Value="@Money(ledger.Rows.Sum(r => r.Debit))" />
                <TotalLine Label="Credit (payments, returns)" Value="@Money(ledger.Rows.Sum(r => r.Credit))" />
                <TotalLine Label="Closing balance" Value="@Money(ledger.Closing)" Strong="true" Danger="@(ledger.Closing > 0)" />
            </RadzenStack>
        </RadzenStack>

        <RadzenDataGrid TItem="LedgerRow" Data="@ledger.Rows" AllowPaging="true" PageSize="50" Density="Density.Compact"
                        EmptyText="No entries in this period.">
            <Columns>
                <RadzenDataGridColumn Title="Date" Width="120px"><Template>@Date(context.Date)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Description">
                    <Template>
                        @if (context.Kind is "Invoice" or "Paid at counter")
                        {
                            <RadzenLink Path="@($"sales/{context.RefId}")" Text="@context.Description" />
                        }
                        else if (context.Kind is "Return" or "Refund")
                        {
                            <RadzenLink Path="@($"sale-returns/{context.RefId}")" Text="@context.Description" />
                        }
                        else
                        {
                            @context.Description
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Debit" Width="130px" TextAlign="TextAlign.Right"><Template>@(context.Debit == 0 ? "" : Money(context.Debit))</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Credit" Width="130px" TextAlign="TextAlign.Right"><Template>@(context.Credit == 0 ? "" : Money(context.Credit))</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Balance" Width="140px" TextAlign="TextAlign.Right"><Template><strong>@Money(context.Balance)</strong></Template></RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private record CustomerOption(int Id, string Label);

    [Parameter] public int? CustomerId { get; set; }

    private List<CustomerOption> customers = [];
    private int customerId, loadVersion;
    private int? routeId;
    private bool loading;
    private DateTime from = new(DateTime.Today.Year, 1, 1), to = DateTime.Today;

    private CustomerLedger? ledger;
    private string shownName = "";
    private DateTime shownFrom, shownTo;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            customers = await db.Customers.AsNoTracking().Where(c => c.Id != Customer.WalkInId).OrderBy(c => c.Name)
                .Select(c => new CustomerOption(c.Id, c.Phone == null ? c.Name : c.Name + " (" + c.Phone + ")"))
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast(NotificationSeverity.Error, FriendlyMessage(ex), 6000);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CustomerId == routeId) return;
        routeId = CustomerId;

        if (CustomerId is int id)
        {
            customerId = id;
            await LoadAsync();
        }
        else
        {
            // /ledger/5 → /ledger (e.g. from the menu): start fresh.
            loadVersion++;
            customerId = 0;
            ledger = null;
            shownName = "";
            loading = false;
        }
    }

    private async Task LoadAsync()
    {
        if (customerId == 0) { ledger = null; return; }
        if (to < from) (from, to) = (to, from);

        var version = ++loadVersion; // ignore results of an older, slower load
        var (id, f, t) = (customerId, from, to);
        loading = true;
        try
        {
            var result = await Reports.GetCustomerLedgerAsync(id, f, t);
            if (version != loadVersion) return;
            ledger = result;
            shownName = customers.FirstOrDefault(c => c.Id == id)?.Label ?? "";
            shownFrom = f;
            shownTo = t;
        }
        catch (Exception ex)
        {
            if (version == loadVersion) ledger = null;
            Toast(NotificationSeverity.Error, FriendlyMessage(ex), 6000);
        }
        finally
        {
            if (version == loadVersion) loading = false;
        }
    }

    private async Task ExportAsync()
    {
        if (ledger is null) return;
        var rows = new List<object?[]> { new object?[] { "Date", "Description", "Debit", "Credit", "Balance" } };
        rows.Add([shownFrom, "Opening balance", null, null, ledger.Opening]);
        rows.AddRange(ledger.Rows.Select(r => new object?[] { r.Date, r.Description, r.Debit, r.Credit, r.Balance }));

        var name = string.Concat(shownName.Split(System.IO.Path.GetInvalidFileNameChars()));
        var path = await Desktop.SaveTextFileAsync($"Ledger - {name}.csv", "CSV files (*.csv)|*.csv", Csv(rows));
        if (path is not null)
            Toast(NotificationSeverity.Success, $"Saved to {path}");
    }
}
