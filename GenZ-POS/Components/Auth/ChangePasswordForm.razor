@inject AuthService Auth
@inject DialogService Dialogs

@* Used full-screen after a first login / password reset (Routes.razor) and as the "Change password" dialog
   (InDialog = true). Errors show inline: the full-screen version has no notification host. *@
<RadzenTemplateForm TItem="PasswordModel" Data="@model" Submit="SaveAsync">
    <RadzenStack Gap="1rem">
        <RadzenFormField Text="Current password" Style="width:100%">
            <RadzenPassword Name="Current" @bind-Value="model.Current" autofocus />
        </RadzenFormField>
        <RadzenFormField Text="@($"New password (at least {AuthService.MinPasswordLength} characters)")" Style="width:100%">
            <RadzenPassword Name="New" @bind-Value="model.New" />
        </RadzenFormField>
        <RadzenFormField Text="New password again" Style="width:100%">
            <RadzenPassword Name="Confirm" @bind-Value="model.Confirm" />
        </RadzenFormField>
        @if (error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">@error</RadzenAlert>
        }
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            @if (InDialog)
            {
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))" />
            }
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save password" Icon="key" IsBusy="busy" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public bool InDialog { get; set; }

    private readonly PasswordModel model = new();
    private string? error;
    private bool busy;

    private async Task SaveAsync()
    {
        busy = true;
        error = null;
        try
        {
            await Auth.ChangePasswordAsync(model.Current, model.New, model.Confirm);
            if (InDialog) Dialogs.Close(true);
        }
        catch (Exception ex)
        {
            error = PageBase.FriendlyMessage(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private class PasswordModel
    {
        public string Current { get; set; } = "";
        public string New { get; set; } = "";
        public string Confirm { get; set; } = "";
    }
}
